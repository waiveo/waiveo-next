# waiveo-feeder — relay/1 server + content origin (Wave-1 first photon).
# Runs beside the legacy stack on a non-conflicting port. Replace the 192.0.2.x
# placeholder in WAIVEO_FEEDER_CONTENT_URL with THIS box's real LAN IP — it is
# baked into the signed snapshot's content URL, which a screen fetches DIRECT,
# so it must be an address the screen can reach (never 127.0.0.1).
[Unit]
Description=Waiveo-next feeder (relay/1 server + content origin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waiveo
Group=waiveo
# Identity + signing keys persist under WorkingDirectory/.dev (see repo
# .gitignore). Keep this path stable across restarts or the feeder re-keys.
WorkingDirectory=/opt/waiveo-next
ExecStart=/opt/waiveo-next/bin/waiveo-feeder
Environment=WAIVEO_FEEDER_LISTEN=0.0.0.0:7420
Environment=WAIVEO_FEEDER_CONTENT_URL=https://192.0.2.10:7420
# Pack-provenance trust root. Deliberately OUTSIDE ReadWritePaths: with
# ProtectSystem=strict this path is read-only to the service, so the process
# that verifies pack signatures cannot add a publisher to the set it verifies
# against, and neither can anything running as its user. Provision it as root
# (0644, root-owned); the feeder refuses a group- or world-writable anchors
# file. Absent ⇒ every pack install refuses (fail closed).
Environment=WAIVEO_FEEDER_PACK_TRUST=/etc/waiveo/pack-trust/anchors.json
# Required-pack roster: which packs THIS deployment cannot run without, and the
# floor version each may not be uninstalled or regressed below. Same posture and
# the same reasons as the trust root above — outside ReadWritePaths, provisioned
# as root 0644 — because writing a roster is not the null grant it looks like:
# adding an entry makes a pack un-uninstallable (an attacker pins their own pack
# in place) and removing one lifts the floor that forbids a downgrade to a
# known-vulnerable version. The feeder refuses a group- or world-writable roster,
# and a group- or world-writable directory holding it.
#
# ABSENT ⇒ no pack is required, and the feeder boots normally; this is the
# default and needs no file. UNRESOLVABLE (unreadable, unparseable, wrong format,
# bad permissions) is NOT the same thing: the feeder refuses to START rather than
# serve with every floor silently lifted. Fix or remove the file.
#
# The document:
#   {
#     "format": "required-packs/1",
#     "required": [
#       { "pack_id": "waiveo/system", "floor_version": "1.4.0" }
#     ]
#   }
Environment=WAIVEO_FEEDER_REQUIRED_PACKS=/etc/waiveo/required-packs.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/waiveo-next

[Install]
WantedBy=multi-user.target
