# waiveo-feeder — relay/1 server + content origin (Wave-1 first photon).
# Runs beside the legacy stack on a non-conflicting port. Replace the 192.0.2.x
# placeholder in WAIVEO_FEEDER_CONTENT_URL with THIS box's real LAN IP — it is
# baked into the signed snapshot's content URL, which a screen fetches DIRECT,
# so it must be an address the screen can reach (never 127.0.0.1).
[Unit]
Description=Waiveo-next feeder (relay/1 server + content origin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waiveo
Group=waiveo
# Identity + signing keys persist under WorkingDirectory/.dev (see repo
# .gitignore). Keep this path stable across restarts or the feeder re-keys.
WorkingDirectory=/opt/waiveo-next
ExecStart=/opt/waiveo-next/bin/waiveo-feeder
# The store, ABSOLUTE and stated, rather than inherited from WorkingDirectory.
# It resolves to the same file either way; what changes is that the store's
# identity stops being a function of the process's working directory. That
# mattered: an operator running `waiveo-feeder -store-check` by hand from any
# other directory used to be answered about a DIFFERENT file, and told nothing
# about it (#195). `-store-check` now takes the path as an argument and prints
# the absolute path it read, and this line is the other half — the unit and the
# hand-run command name the same store.
Environment=WAIVEO_FEEDER_STORE=/opt/waiveo-next/.dev/feeder-store.db
Environment=WAIVEO_FEEDER_LISTEN=0.0.0.0:7420
Environment=WAIVEO_FEEDER_CONTENT_URL=https://192.0.2.10:7420
# Pack-provenance trust root. Deliberately OUTSIDE ReadWritePaths: with
# ProtectSystem=strict this path is read-only to the service, so the process
# that verifies pack signatures cannot add a publisher to the set it verifies
# against, and neither can anything running as its user. Provision it as root
# (0644, root-owned); the feeder refuses a group- or world-writable anchors
# file. Absent ⇒ every pack install refuses (fail closed).
Environment=WAIVEO_FEEDER_PACK_TRUST=/etc/waiveo/pack-trust/anchors.json
# Required-pack roster: which packs THIS deployment cannot run without, and the
# floor version each may not be uninstalled or regressed below. Same posture and
# the same reasons as the trust root above — outside ReadWritePaths, provisioned
# as root 0644 — because writing a roster is not the null grant it looks like:
# adding an entry makes a pack un-uninstallable (an attacker pins their own pack
# in place) and removing one lifts the floor that forbids a downgrade to a
# known-vulnerable version. The feeder refuses a group- or world-writable roster,
# and a group- or world-writable directory holding it.
#
# ABSENT ⇒ no pack is required, and the feeder boots normally; this is the
# default and needs no file. UNRESOLVABLE (unreadable, unparseable, wrong format,
# bad permissions) is NOT the same thing: the feeder refuses to START rather than
# serve with every floor silently lifted. Fix or remove the file.
#
# The document:
#   {
#     "format": "required-packs/1",
#     "required": [
#       { "pack_id": "waiveo/system", "floor_version": "1.4.0" }
#     ]
#   }
Environment=WAIVEO_FEEDER_REQUIRED_PACKS=/etc/waiveo/required-packs.json
# Registry sources: the ORDERED list of registries this box resolves a pack
# install by marketplace reference against, and — per source — which of
# marketplace/1 MKT-062's reserved publisher namespaces the HOST authorizes that
# source to serve. Same posture and the same reasons as the two above: outside
# ReadWritePaths, provisioned as root 0644, and refused if it or any directory
# holding it is group- or world-writable. Whoever can write this file names a
# registry this box fetches code from.
#
# It grants NO trust. A resolved artifact is verified by the same signature
# envelope, against the same anchors above, as one uploaded by hand — a registry
# says where bytes live, never that they may be run.
#
# ABSENT ⇒ no registry source: installing a pack FILE works exactly as before,
# and installing by marketplace reference refuses with MARKETPLACE_REF_UNRESOLVED.
# This is the default and needs no file. UNUSABLE (unreadable, unparseable, wrong
# format, bad permissions, one invalid source) ⇒ the box still BOOTS and still
# installs pack files, with NO source configured and the reason logged. It loads
# whole or not at all: a partly-read list would silently reorder the resolution
# preference MKT-061 makes the operator's to declare.
#
# The document — order is the resolution preference, and `reserved_namespaces`
# defaults to NONE, so a source not listed for `waiveo` cannot serve a
# `waiveo/...` pack (REGISTRY_SOURCE_NOT_DELEGATED):
#   {
#     "format": "registry-sources/1",
#     "sources": [
#       {
#         "id": "local",
#         "channel": "marketplace/stable",
#         "index_url": "file:///var/lib/waiveo/registry/index.json",
#         "reserved_namespaces": ["waiveo"]
#       },
#       {
#         "id": "upstream",
#         "channel": "marketplace/stable",
#         "index_url": "https://registry.example/marketplace/index.json"
#       }
#     ]
#   }
#
# index_url takes file:/// (an absolute path on this box — the directory holding
# it becomes the root every fetch from that source is confined to, so the index
# and its artifacts live in one tree) or https:// (confined to that one origin,
# no redirects, capped and timed out). Plaintext http:// is refused: an index in
# the clear is rewritable in flight, including to hide a yank. Every file://
# resolution is marked stale_source (MKT-063); that is derived from the scheme
# and cannot be declared away.
Environment=WAIVEO_FEEDER_PACK_SOURCES=/etc/waiveo/pack-sources.json
# Who will start a replacement when this process exits (api/1 API-154). It is
# DECLARED here and never detected by the process, for one reason: every systemd
# unit's processes carry INVOCATION_ID, including a unit written `Restart=no`, so
# a process that sniffed its environment would answer "supervised" with total
# confidence on exactly the deployment where being wrong means an operator presses
# Restart in the console and the box never comes back. Only whoever wrote this
# file knows the answer, so this is where it is written.
#
# THIS LINE AND `Restart=always` BELOW ARE ONE STATEMENT. Changing either without
# the other is the bug: dropping the variable makes a working restart refuse
# RESTART_UNSUPPORTED (annoying, safe); dropping `Restart=always` makes an
# accepted restart stop the box for good (quiet, not safe). Unset it deliberately
# — and only alongside `Restart=no`/`on-failure` — if this deployment must not be
# restartable from the console.
Environment=WAIVEO_FEEDER_SUPERVISOR=systemd
# `always`, not `on-failure`, and that is what makes the restart operation work.
# An operator-requested restart drains gracefully and exits 0 — a CLEAN exit,
# which `on-failure` deliberately does not restart. The alternative was to exit
# non-zero so `on-failure` would catch it, which would file every intentional
# restart in the journal as a service failure and make a real failure
# indistinguishable from a button press.
#
# It does not make `systemctl stop` sticky: systemd does not re-start a unit it
# stopped by an explicit stop job, whatever `Restart=` says. The only clean exit
# this binary has that is NOT an explicit stop is the restart operation.
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/waiveo-next

[Install]
WantedBy=multi-user.target
