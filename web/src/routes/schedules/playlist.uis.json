{
  "pageType": "list-detail",
  "context": { "casts": { "collection": "casts" } },
  "list": {
    "source": "playlists",
    "display": {
      "type": "table",
      "id": "Playlists",
      "props": {
        "source": "playlists",
        "columns": [
          { "headerMsg": "msg:pl.col.name", "cell": "item.name" },
          { "headerMsg": "msg:pl.col.count", "cell": { "compute": "count", "args": ["item.items"] } }
        ]
      },
      "on": { "rowPress": { "verb": "set", "target": "$ui.selected", "value": "item.id" } }
    }
  },
  "detail": {
    "source": "playlists[id=$ui.selected]",
    "emptyMsg": "msg:pl.detail.empty",
    "root": {
      "type": "section",
      "props": { "titleMsg": "msg:pl.detail.title" },
      "children": [
        {
          "type": "text-input",
          "bind": "name",
          "props": { "labelMsg": "msg:pl.name" }
        },
        {
          "type": "repeat",
          "bind": "items",
          "props": {
            "itemScope": "item",
            "emptyMsg": "msg:pl.items.empty",
            "itemTemplate": {
              "type": "section",
              "children": [
                {
                  "type": "select",
                  "bind": "item.source",
                  "props": {
                    "labelMsg": "msg:pl.item.source",
                    "options": {
                      "kind": "literal",
                      "items": [
                        { "value": "asset", "labelMsg": "msg:pl.item.source.asset" },
                        { "value": "cast", "labelMsg": "msg:pl.item.source.cast" },
                        { "value": "playable", "labelMsg": "msg:pl.item.source.playable" }
                      ]
                    }
                  }
                },
                {
                  "type": "text-input",
                  "bind": "item.asset_ref",
                  "visibleIf": { "compute": "eq", "args": ["item.source", { "lit": "asset" }] },
                  "props": { "labelMsg": "msg:pl.item.ref", "placeholderMsg": "msg:pl.item.refPh" }
                },
                {
                  "type": "select",
                  "bind": "item.cast_id",
                  "visibleIf": { "compute": "eq", "args": ["item.source", { "lit": "cast" }] },
                  "props": {
                    "labelMsg": "msg:pl.item.cast",
                    "placeholderMsg": "msg:pl.item.castPh",
                    "options": {
                      "kind": "data",
                      "source": "$context.casts",
                      "valuePath": "id",
                      "labelPath": "name"
                    }
                  }
                },
                {
                  "type": "text",
                  "visibleIf": { "compute": "eq", "args": ["item.source", { "lit": "cast" }] },
                  "props": { "value": { "compute": "msg", "args": ["msg:pl.item.castNote"] } }
                },
                {
                  "type": "text-input",
                  "bind": "item.pack_id",
                  "visibleIf": { "compute": "eq", "args": ["item.source", { "lit": "playable" }] },
                  "props": { "labelMsg": "msg:pl.item.pack" }
                },
                {
                  "type": "text-input",
                  "bind": "item.content_id",
                  "visibleIf": { "compute": "eq", "args": ["item.source", { "lit": "playable" }] },
                  "props": { "labelMsg": "msg:pl.item.content" }
                },
                {
                  "type": "duration-input",
                  "bind": "item.duration_seconds",
                  "props": { "labelMsg": "msg:pl.item.dur", "displayUnit": "s" }
                },
                {
                  "type": "button",
                  "props": { "labelMsg": "msg:pl.item.remove", "style": "destructive" },
                  "on": { "press": { "verb": "repeat-remove", "target": "item" } }
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:pl.item.add" },
          "on": {
            "press": {
              "verb": "repeat-add",
              "target": "items",
              "itemDefault": { "source": "asset", "asset_ref": "", "duration_seconds": 10 }
            }
          }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:pl.item.addCast" },
          "on": {
            "press": {
              "verb": "repeat-add",
              "target": "items",
              "itemDefault": { "source": "cast", "cast_id": "", "duration_seconds": 10 }
            }
          }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:pl.save", "style": "primary" },
          "on": { "press": { "verb": "submit" } }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:pl.delete", "style": "destructive" },
          "on": { "press": { "verb": "delete", "target": "$root" } }
        }
      ]
    }
  },
  "newAction": {
    "verb": "create",
    "target": "playlists",
    "itemDefault": { "name": "New playlist", "items": [] }
  }
}
