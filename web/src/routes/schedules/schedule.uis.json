{
  "pageType": "list-detail",
  "list": {
    "source": "schedules",
    "display": {
      "type": "table",
      "id": "Schedules",
      "props": {
        "source": "schedules",
        "columns": [
          { "headerMsg": "msg:sched.col.name", "cell": "item.name" }
        ]
      },
      "on": { "rowPress": { "verb": "set", "target": "$ui.selected", "value": "item.id" } }
    }
  },
  "detail": {
    "source": "schedules[id=$ui.selected]",
    "emptyMsg": "msg:sched.detail.empty",
    "root": {
      "type": "section",
      "props": { "titleMsg": "msg:sched.detail.title" },
      "children": [
        {
          "type": "text-input",
          "bind": "name",
          "props": { "labelMsg": "msg:sched.detail.name" }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:sched.detail.save", "style": "primary" },
          "on": { "press": { "verb": "submit" } }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:sched.detail.delete", "style": "destructive" },
          "on": { "press": { "verb": "delete", "target": "$root" } }
        }
      ]
    }
  },
  "newAction": {
    "verb": "create",
    "target": "schedules",
    "itemDefault": { "name": "New schedule" }
  }
}
