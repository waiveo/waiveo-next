{
  "pageType": "settings-form",
  "source": "daypart",
  "context": { "playlists": { "collection": "playlists" } },
  "sections": [
    {
      "titleMsg": "msg:dp.section.window",
      "fields": [
        {
          "type": "text-input",
          "bind": "name",
          "props": { "labelMsg": "msg:dp.name", "placeholderMsg": "msg:dp.namePh" }
        },
        {
          "type": "multi-select",
          "bind": "days_of_week",
          "props": {
            "labelMsg": "msg:dp.days",
            "options": {
              "kind": "literal",
              "items": [
                { "value": 1, "labelMsg": "msg:dp.mon" },
                { "value": 2, "labelMsg": "msg:dp.tue" },
                { "value": 3, "labelMsg": "msg:dp.wed" },
                { "value": 4, "labelMsg": "msg:dp.thu" },
                { "value": 5, "labelMsg": "msg:dp.fri" },
                { "value": 6, "labelMsg": "msg:dp.sat" },
                { "value": 0, "labelMsg": "msg:dp.sun" }
              ]
            }
          }
        },
        {
          "type": "time-of-day",
          "bind": "start_time",
          "props": { "labelMsg": "msg:dp.start" }
        },
        {
          "type": "time-of-day",
          "bind": "end_time",
          "props": { "labelMsg": "msg:dp.end" }
        }
      ]
    },
    {
      "titleMsg": "msg:dp.section.display",
      "fields": [
        {
          "type": "select",
          "bind": "display_power",
          "props": {
            "labelMsg": "msg:dp.power",
            "options": {
              "kind": "literal",
              "items": [
                { "value": "on", "labelMsg": "msg:dp.power.on" },
                { "value": "blank", "labelMsg": "msg:dp.power.blank" },
                { "value": "off", "labelMsg": "msg:dp.power.off" }
              ]
            }
          }
        },
        {
          "type": "select",
          "bind": "playlist_id",
          "visibleIf": { "compute": "eq", "args": ["display_power", { "lit": "on" }] },
          "props": {
            "labelMsg": "msg:dp.playlist",
            "placeholderMsg": "msg:dp.playlistPh",
            "options": {
              "kind": "data",
              "source": "$context.playlists",
              "valuePath": "id",
              "labelPath": "name"
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "button",
      "props": { "labelMsg": "msg:dp.save", "style": "primary" },
      "on": { "press": { "verb": "submit" } }
    }
  ]
}
