{
  "pageType": "list-detail",
  "list": {
    "source": "screens",
    "display": {
      "type": "table",
      "id": "Screens",
      "props": {
        "source": "screens",
        "columns": [
          { "headerMsg": "msg:screens.col.name", "cell": "item.name" },
          { "headerMsg": "msg:screens.col.tz", "cell": "item.tz" }
        ]
      },
      "on": { "rowPress": { "verb": "set", "target": "$ui.selected", "value": "item.id" } }
    }
  },
  "detail": {
    "source": "screens[id=$ui.selected]",
    "emptyMsg": "msg:screens.detail.empty",
    "root": {
      "type": "section",
      "props": { "titleMsg": "msg:screens.detail.title" },
      "children": [
        {
          "type": "text-input",
          "bind": "name",
          "props": { "labelMsg": "msg:screens.detail.name" }
        },
        {
          "type": "text-input",
          "bind": "tz",
          "props": {
            "labelMsg": "msg:screens.detail.tz",
            "placeholderMsg": "msg:screens.detail.tzPlaceholder"
          }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:screens.detail.save", "style": "primary" },
          "on": { "press": { "verb": "submit" } }
        },
        {
          "type": "button",
          "props": { "labelMsg": "msg:screens.detail.delete", "style": "destructive" },
          "on": { "press": { "verb": "delete", "target": "$root" } }
        }
      ]
    }
  },
  "newAction": {
    "verb": "create",
    "target": "screens",
    "itemDefault": { "kind": "screen", "name": "New screen" }
  }
}
