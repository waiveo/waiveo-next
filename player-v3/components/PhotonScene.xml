<?xml version="1.0" encoding="utf-8" ?>
<!-- PhotonScene: a black backdrop, a full-screen Poster (image) or Video (video)
     that cycles through an ordered cast's items (PLY-083a — a "cast" of one
     or more content items, ordinary single-item Leases being the degenerate
     one-item case), castTimer driving an image item's own dwell time
     (PLY-083b), a "composedLayers" Group that holds dynamically created
     full-screen Poster/Video children for a "composed" item (PLY-015 —
     stacked in layers array order, index 0 furthest back), and a status
     Label shown until content renders, and idleDefeatHeartbeat keeping the
     single IdleDefeatTask that holds the platform's own idle/inactivity
     surface off assigned content alive (PLY-158 — see IdleDefeat.brs).
     pairingCode is set by Main from the launch args; the scene starts the
     PlayerTask once it has a code (or is already paired). shutdown() is
     called by Main when the screen closes, and is what stops this scene's
     Task threads — a Task thread outlives the node that owns it, so it has to
     be told. Storage and IdleDefeat are included for wvStorageLoad / the
     idle-defeat helpers (component scopes do not inherit pkg:/source
     globals). -->
<component name="PhotonScene" extends="Scene">
  <interface>
    <field id="pairingCode" type="string" />
    <function name="shutdown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PhotonScene.brs" />
  <script type="text/brightscript" uri="pkg:/source/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/IdleDefeat.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
    <Poster id="contentPoster" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="false" />
    <Video id="contentVideo" width="1920" height="1080" visible="false" />
    <Group id="composedLayers" visible="false" />
    <!-- slideLayers holds the dynamically created, individually positioned
         Label/Rectangle/Poster children of a "slide" content item (native
         slide rendering, PLY-012's "slide" content type). Unlike composedLayers
         (full-screen stacked), each child is translated to its own [x,y] and
         sized to its own w×h in the 1920×1080 canvas, in layers array order
         (index 0 furthest back). -->
    <Group id="slideLayers" visible="false" />
    <Label id="statusLabel" text="Waiveo Player v3" translation="[80,960]" width="1760" />
    <Timer id="castTimer" repeat="false" />
    <!-- slideClockTimer refreshes every "clock" layer's Label with the current
         local time once a second while a slide with a clock is showing. It is a
         fixed node (like castTimer) rather than one created per slide, so this
         scene always holds a handle to STOP it on item change and on shutdown —
         a per-slide timer left running past its slide is exactly the
         outlives-its-owner leak this player already fixed for Task threads. It
         is started only for a slide that actually carries a clock layer, and is
         stopped whenever the slide is torn down (clearSlide) or the scene shuts
         down. -->
    <Timer id="slideClockTimer" repeat="true" />
    <!-- PLY-158's idle defeat does its actual work on IdleDefeatTask (the
         platform call it makes cannot be made on this thread at all). This
         timer is only that Task's liveness signal: it beats for as long as
         this scene is alive, whether or not content is assigned, so the Task
         can tell "nothing assigned right now" from "my owner is gone" and
         self-exit in the second case. Declared here rather than created at
         runtime, and its duration is set in init from
         wvIdleDefeatOwnerHeartbeatSeconds() so the cadence has one home. -->
    <Timer id="idleDefeatHeartbeat" repeat="true" />
  </children>
</component>
