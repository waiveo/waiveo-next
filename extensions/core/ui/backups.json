{
  "pageType": "settings-form",
  "source": "backups",
  "sections": [
    {
      "titleMsg": "msg:backups.schedule.title",
      "fields": [
        { "type": "text-input", "bind": "schedule", "props": { "labelMsg": "msg:backups.schedule", "placeholderMsg": "msg:backups.schedule.placeholder" } }
      ]
    },
    {
      "titleMsg": "msg:backups.retention.title",
      "fields": [
        { "type": "number-input", "bind": "keep_last", "props": { "labelMsg": "msg:backups.keepLast", "min": 0, "step": 1 } },
        { "type": "number-input", "bind": "keep_days", "props": { "labelMsg": "msg:backups.keepDays", "min": 0, "step": 1 } },
        { "type": "toggle", "bind": "notify_on_failure", "props": { "labelMsg": "msg:backups.notify" } }
      ]
    }
  ],
  "actions": [
    { "type": "button", "props": { "labelMsg": "msg:backups.save", "style": "primary" }, "on": { "press": { "verb": "submit" } } },
    { "type": "button", "props": { "labelMsg": "msg:backups.run" }, "on": { "press": { "verb": "call-action", "target": "run-backup" } } }
  ]
}
