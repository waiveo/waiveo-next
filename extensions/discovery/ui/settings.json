{
  "pageType": "settings-form",
  "source": "settings",
  "sections": [
    {
      "titleMsg": "msg:settings.scope.title",
      "fields": [
        { "type": "text-input", "bind": "subnets", "props": { "labelMsg": "msg:settings.subnets", "placeholderMsg": "msg:settings.subnets.placeholder" } }
      ]
    },
    {
      "titleMsg": "msg:settings.schedule.title",
      "fields": [
        { "type": "text-input", "bind": "schedule", "props": { "labelMsg": "msg:settings.schedule", "placeholderMsg": "msg:settings.schedule.placeholder" } }
      ]
    },
    {
      "titleMsg": "msg:settings.rate.title",
      "fields": [
        { "type": "number-input", "bind": "max_concurrent", "props": { "labelMsg": "msg:settings.maxConcurrent", "min": 1, "step": 1 } },
        { "type": "number-input", "bind": "probe_timeout_ms", "props": { "labelMsg": "msg:settings.probeTimeout", "min": 50, "step": 50 } }
      ]
    }
  ],
  "actions": [
    { "type": "button", "props": { "labelMsg": "msg:settings.save", "style": "primary" }, "on": { "press": { "verb": "submit" } } },
    { "type": "button", "props": { "labelMsg": "msg:settings.scanNow" }, "on": { "press": { "verb": "call-action", "target": "scan-now" } } }
  ]
}
