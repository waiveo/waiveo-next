node_modules/
dist/
# The web console build output is generated by `make web-build` and is fully
# ignored — a deterministic Vite build must never show up as a repo diff. web/dist
# is pure Vite output. internal/app/webui/dist is the go:embed tree: ONLY the
# committed `.gitkeep` sentinel is tracked, so `//go:embed all:dist` always has a
# file and `go build ./...` stays green without a Node build; when no built
# index.html is embedded the handler serves a Go-string placeholder shell. The
# built index.html + hashed assets stay ignored under both dirs.
!internal/app/webui/dist/
internal/app/webui/dist/*
!internal/app/webui/dist/.gitkeep
.DS_Store
*.log
.superpowers/
.dev/
# Playwright (dev-only click-through gate, web/): the runner's report + artifact
# output and its browser cache. Browsers download to the OS cache
# (~/Library/Caches/ms-playwright), never the repo; these dirs are pure run output.
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/
web/.last-run.json
# Feeder relay/1 signing keypair + self-signed TLS cert (make-dev-local,
# generated by internal/feeder/signing.LoadOrCreate). Already covered by
# .dev/ above; called out explicitly so key material never gets committed
# even if .dev/ is ever narrowed.
.dev/feeder-keys/
# Relay relay/1 operational SQLite (make-dev-local, generated by
# internal/relay/identity.Open) — holds the relay's own enrollment private
# key. Same rationale as .dev/feeder-keys/ above.
.dev/relay-identity/

# graphify (local knowledge graph, on-demand dev tooling)
graphify-out/
