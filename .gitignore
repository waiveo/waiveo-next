node_modules/
dist/
# The web console build output is generated by `make web-build`. Only the
# committed placeholder index.html files are tracked — they keep `go build ./...`
# green (the feeder embeds internal/app/webui/dist) without requiring a Node
# build, and mark web/dist as the Vite output location. Everything else the
# build emits stays ignored.
!web/dist/
web/dist/*
!web/dist/index.html
!internal/app/webui/dist/
internal/app/webui/dist/*
!internal/app/webui/dist/index.html
.DS_Store
*.log
.superpowers/
.dev/
# Feeder relay/1 signing keypair + self-signed TLS cert (make-dev-local,
# generated by internal/feeder/signing.LoadOrCreate). Already covered by
# .dev/ above; called out explicitly so key material never gets committed
# even if .dev/ is ever narrowed.
.dev/feeder-keys/
# Relay relay/1 operational SQLite (make-dev-local, generated by
# internal/relay/identity.Open) — holds the relay's own enrollment private
# key. Same rationale as .dev/feeder-keys/ above.
.dev/relay-identity/
